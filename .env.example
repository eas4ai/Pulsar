APP_NAME="Pulsar"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8765
VITE_APP_NAME=Pulsar

# Public metadata and crawler discovery. APP_URL must be the canonical origin.
SEO_DESCRIPTION="A production-ready Suprnova starter kit with accounts, documentation, publishing, community pages, and an Inertia/Vue frontend."
SEO_SOCIAL_IMAGE=/social-card.jpg
SEO_SOCIAL_IMAGE_WIDTH=1280
SEO_SOCIAL_IMAGE_HEIGHT=720
SEO_LANGUAGE=en
SEO_LOCALE=en_US
SEO_THEME_COLOR="#0b1020"
SEO_COLOR_SCHEME="dark light"
SEO_REPOSITORY_URL=https://github.com/eas4ai/Pulsar
# SEO_TWITTER_SITE=@yourhandle

# 32-byte AES-256 key (URL-safe base64, no padding). Generate one with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Then copy it into your `.env`. Required in
# production - Suprnova fails closed on boot when APP_ENV is not
# local/dev/test and APP_KEY is unset.
APP_KEY=

# Backend + Vite ports. Distinctive defaults avoid common 8080/5173 collisions.
SERVER_HOST=127.0.0.1
SERVER_PORT=8765

# Which frontend the HTML shell renders (svelte | react | vue). The kit
# also pins this in code on the config passed to `Inertia::install`.
SUPRNOVA_FRONTEND=vue
VITE_PORT=5765

# Browser security policy. Start production in report-only mode, inspect
# violations, then set this to false to enforce the balanced policy.
SECURITY_HEADERS=balanced
SECURITY_HEADERS_CSP_REPORT_ONLY=true
# SECURITY_HEADERS_CSP_REPORT_TO=https://reports.example.com/csp
# Leave HSTS preload off unless the domain has deliberately joined the preload list.
SECURITY_HEADERS_HSTS_PRELOAD=false

# Preserve keys written by Suprnova 3.2.1. Remove the empty value only when
# you deliberately migrate Redis data to Suprnova 4's application prefix.
REDIS_PREFIX=

# Error reporting is opt-in. Set the driver to sentry and supply a private
# server DSN when the deployment has a Sentry-compatible collector.
REPORTING_DRIVER=null
# REPORTING_DSN=https://public-key@reports.example.com/project-id
# REPORTING_RELEASE=pulsar@2.1.1
# REPORTING_LOGS=error
# REPORTING_TRACES_SAMPLE_RATE=0
# REPORTING_SEND_PII=false

# Generated content. Refresh docs before releases or after editing content/docs.
# Articles are database-backed; run `articles:seed` for starter examples.
#   cargo run --bin console -- docs:build
#   cargo run --bin console -- articles:seed

# Database (SQLite by default, change to postgres://user:pass@localhost:5432/dbname for PostgreSQL)
DATABASE_URL=sqlite://./database.db
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_CONNECT_TIMEOUT=30
DB_LOGGING=false

# Mail
MAIL_DRIVER=log
MAIL_FROM="hello@pulsar.test"
# To send real mail in dev, run Mailpit (https://github.com/axllent/mailpit) and swap:
#   MAIL_DRIVER=smtp
#   MAIL_SMTP_HOST=localhost
#   MAIL_SMTP_PORT=1025
#   MAIL_SMTP_ENCRYPTION=none
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_SMTP_ENCRYPTION=none
# Production: starttls (usually 587) or tls (usually 465), with BOTH credentials.
# MAIL_SMTP_USER=your-provider-user
# MAIL_SMTP_PASS=your-provider-secret
MAIL_FROM_NAME="Pulsar"
